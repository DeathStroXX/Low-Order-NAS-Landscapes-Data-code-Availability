def _create_random_chromosome(self):
    chromosome = {}
    for key, values in self.search_space.items():
        if key in ['n_columns', 'base_channels', 'n_blocks']:
            chromosome[key] = random.choice(values)
        elif key in ['dropout_prob', 'fc_dropout']:
            chromosome[key] = random.choice(values)
        elif key in ['lr', 'momentum']:
            chromosome[key] = random.choice(values)
        elif key in ['activation', 'kernel_size', 'pooling_type', 'conv_type', 'norm_type', 'optimizer_type']:
            chromosome[key] = random.choice(values)
    return chromosome
```

