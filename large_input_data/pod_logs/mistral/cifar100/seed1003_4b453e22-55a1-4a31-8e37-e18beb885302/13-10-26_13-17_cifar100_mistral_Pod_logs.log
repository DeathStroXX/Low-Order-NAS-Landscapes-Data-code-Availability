def select_competitor(self, competitors):
    elitist_competitors = [chromo for chromo in self.population if chromo['fitness'] is not None]

    if len(elitist_competitors) >= self.elitism_count:
        elitism_tournament_size = self.elitism_count
    else:
        elitism_tournament_size = len(elitist_competitors)

    exploration_tournament_size = self.population_size - elitism_tournament_size
    exploration_competitors = random.sample(self.population, exploration_tournament_size)

    competitors.extend(elitist_competitors)
    competitors.extend(exploration_competitors)

    competitors_fitness = [chromo['fitness'] for chromo in competitors]
    unique_fitness, _ = np.unique(competitors_fitness, return_index=True)

    best_competitor_index = unique_fitness[np.argmax(competitors_fitness[unique_fitness])]

    return competitors[best_competitor_index]
```

