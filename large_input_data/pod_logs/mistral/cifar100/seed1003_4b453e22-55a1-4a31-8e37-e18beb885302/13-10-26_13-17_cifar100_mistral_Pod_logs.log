### combine_genes ###
def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_index < crossover_point:
        return parent1_value
    else:
        # Decide whether to swap parent1 and parent2 based on a custom probability function
        swap_probability = self.mutation_rate * (gene_index / total_genes)
        if random.random() < swap_probability:
            if gene_index < crossover_point:
                # Swap parent1_value with a random value from the search space
                possibles = [v for v in self.search_space[gene_name] if v != parent1_value]
                if possibles:
                    return random.choice(possibles)
            else:
                # Swap parent2_value with a random value from the search space
                possibles = [v for v in self.search_space[gene_name] if v != parent2_value]
                if possibles:
                    return random.choice(possibles)
        else:
            # If not swapped, apply mutation to parent2_value with a higher probability as we move towards the end of the chromosome
            mutation_probability = self.mutation_rate * 4 * (total_genes - gene_index)
            if random.random() < mutation_probability:
                # Mutate parent2_value
                possibles = [v for v in self.search_space[gene_name] if v != parent2_value]
                if possibles:
                    return random.choice(possibles)

    return parent2_value
```

This updated implementation introduces a custom swap probability that increases as we move towards the end of the chromosome, encouraging more swaps and exploration. Additionally, the mutation probability is also increased towards the end of the chromosome to further encourage exploration and break out of local minima.
