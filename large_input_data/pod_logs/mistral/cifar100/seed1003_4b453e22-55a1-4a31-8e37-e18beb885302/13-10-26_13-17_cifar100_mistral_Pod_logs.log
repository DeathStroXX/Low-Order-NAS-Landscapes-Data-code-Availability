### mutate_gene ###
def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            # Increase mutation probability and make it more aggressive
            mutation_probability = self.mutation_rate * 6
            if random.random() < mutation_probability:
                # If the current value is common, move away from it by choosing an extreme value
                if current_value in self.search_space[gene_name][:int(len(self.search_space[gene_name])/3)]:
                    # Choose a value that is more extreme than the current one
                    if len(choices) > int(len(choices)/3):
                        return max(choices[:int(len(choices)/6)], key=lambda x: abs(x - min(choices)) + abs(x - max(choices)))
                    else:
                        return max(choices)
                else:
                    # If the current value is rare, move towards it by choosing a value closer to the center of the choices
                    center = sum(choices) / len(choices)
                    return choices[choices.index(center)]
            elif random.random() < self.mutation_rate * 3:
                # If the current value is not common, move towards the opposite end of the choices
                return min(choices) if current_value < min(choices) else max(choices)
    return current_value
```

This modification increases the mutation probability and encourages the GA to move towards more extreme values when the current value is common, and towards the opposite end of the choices when the current value is rare. Additionally, if the choices are limited, it simply chooses the center value.
