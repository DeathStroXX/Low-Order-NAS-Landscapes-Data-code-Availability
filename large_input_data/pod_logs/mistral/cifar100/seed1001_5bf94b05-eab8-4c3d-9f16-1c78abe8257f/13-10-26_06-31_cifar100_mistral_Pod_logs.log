### combine_genes ###
def combine_genes(self, gene_name, parent1_chromo, parent2_chromo, crossover_point, gene_index, total_genes):
    # Ensure that crossover_point is within the total genes
    crossover_point = min(crossover_point, total_genes)

    # Use a random value from the search space if crossover_point equals total genes
    if crossover_point == total_genes:
        return random.choice(self.search_space[gene_name])

    # Combine genes if gene_index is less than crossover_point
    if gene_index < crossover_point:
        child_chromo = parent1_chromo
    else:
        child_chromo = parent2_chromo

    # Implement strategies to maintain genetic diversity and avoid premature convergence
    # 1. Gene Mutation: Change a certain percentage of genes in the child chromosome randomly to values from the search space
    crossover_rate = self.crossover_rate
    mutation_rate = self.mutation_rate
    mutation_percentage = mutation_rate * total_genes

    for i in range(gene_index, total_genes):
        if random.random() < crossover_rate and i < crossover_point:
            child_chromo[gene_name] = random.choice(self.search_space[gene_name])
        elif random.random() < mutation_rate:
            mutation_point = random.randint(0, mutation_percentage)
            if mutation_point < mutation_percentage:
                new_value = random.choice(self.search_space[gene_name])
