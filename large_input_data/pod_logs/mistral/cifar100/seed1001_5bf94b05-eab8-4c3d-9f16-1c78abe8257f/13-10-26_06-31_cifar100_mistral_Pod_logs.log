def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Ensure that crossover_point is within the total genes
    crossover_point = min(crossover_point, total_genes)

    # Use a random value from the search space if crossover_point equals total genes
    if crossover_point == total_genes:
        return random.choice(self.search_space[gene_name])

    # Combine genes if gene_index is less than crossover_point
    if gene_index < crossover_point:
        return parent1_value
    else:
        # Incorporate strategies to maintain genetic diversity and avoid premature convergence
        # 1. Gene Mutation: Change a certain percentage of genes in the child chromosome randomly to values from the search space
        mutation_percentage = self.mutation_rate * total_genes
        if gene_index < crossover_point:
            mutation_point = random.randint(0, gene_index)
            if mutation_point < mutation_percentage:
                new_value = self._mutate_gene(gene_name, parent1_value[mutation_point])
                if new_value is not None:
                    parent1_value[mutation_point] = new_value

        # 2. Gene Swap: Swap two genes in the child chromosome with a certain probability
        swap_probability = self.mutation_rate / 2
        if gene_index >= crossover_point and random.random() < swap_probability:
            swap_point = random.randint(crossover_point, total_genes)
            parent1_value[swap_point], parent1_value[gene_index] = parent1_value[gene_index], parent1_value[swap_point]

        return tuple(parent1_value)

    def _mutate_gene(self, gene_name, current_value):
        if current_value is None:
            return None
        possible_values = [val for val in self.search_space[gene_name] if val != current_value]
        if possible_values:
            mutation_probability = self.mutation_rate * 2
            if gene_name in ['n_columns', 'base_channels', 'n_blocks']:
                uncommon_values = [val for val in possible_values if val not in [current_value] + self.search_space[gene_name][:-1]]
                if uncommon_values:
                    mutation_probability *= 2
            if len(possible_values) == 1 and gene_name in ['n_columns', 'base_channels', 'n_blocks']:
                mutation_probability *= 2
            if random.random() < mutation_probability:
                return random.choice(possible_values)
        return current_value
```

