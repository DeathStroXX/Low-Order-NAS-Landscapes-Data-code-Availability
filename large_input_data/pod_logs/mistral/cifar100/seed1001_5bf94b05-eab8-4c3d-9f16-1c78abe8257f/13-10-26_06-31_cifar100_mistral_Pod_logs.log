def _tournament_selection(self, tournament):
    if len(tournament) < 2:
        return max(tournament, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)

    winners = [self._tournament_selection(tournament[:len(tournament)//2])] + [self._tournament_selection(tournament[len(tournament)//2:])]
    return max(winners, key=lambda x: x['fitness'] if x['fitness'] is not None else -1)
```

