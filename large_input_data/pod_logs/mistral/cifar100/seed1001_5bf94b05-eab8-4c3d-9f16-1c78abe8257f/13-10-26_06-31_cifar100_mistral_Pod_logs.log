def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate

            if len(choices) == 1:
                # Force at least 2 mutations for these gene types to prevent getting stuck
                if len(current_chromosome) <= 3:
                    mutation_probability *= 2

            if random.random() < mutation_probability:
                if gene_name in ["n_columns", "base_channels", "n_blocks"]:
                    # Encourage combining uncommon values for these gene types to explore new architectures
                    combined_choice = random.choice(list(set(possible_values) & set(self.search_space[gene_name])))
                    return combined_choice
                else:
                    return random.choice(choices)

            # If mutation doesn't occur, consider multiple gene swaps for larger chromosomes
            elif len(choices) > 1 and len(current_chromosome) > 6:
                swap_count = min(2, len(choices))
                swapped_genes = random.sample(choices, swap_count)
                mutated_chromosome = current_chromosome.copy()
                for gene in swapped_genes:
                    mutated_gene = random.choice(list(self.search_space.keys()))
                    mutated_chromosome[gene], mutated_chromosome[mutated_gene] = mutated_chromosome[mutated_gene], mutated_chromosome[gene]
                return mutated_chromosome

    return current_value
```

