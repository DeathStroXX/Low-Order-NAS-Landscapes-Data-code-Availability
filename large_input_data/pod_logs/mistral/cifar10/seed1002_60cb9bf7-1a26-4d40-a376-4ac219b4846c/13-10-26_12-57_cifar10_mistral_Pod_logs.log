def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))

        # Increase mutation probability for certain genes to encourage more drastic changes
        if gene_name in ["n_columns", "base_channels", "n_blocks", "dropout_prob", "fc_dropout", "lr", "momentum"]:
            mutation_probability = self.mutation_rate * 4  # Increase mutation probability for these genes
        else:
            mutation_probability = self.mutation_rate * 2  # Regular mutation probability for other genes

        if random.random() < mutation_probability:
            # Try generating a random neighbor architecture for certain genes
            if gene_name in ["n_columns", "base_channels", "n_blocks"]:
                # Randomly move the gene value within its bounds
                if gene_name == "n_columns":
                    new_value = random.randint(min(self.search_space["n_columns"]), max(self.search_space["n_columns"]))
                elif gene_name == "base_channels":
                    new_value = random.randint(min(self.search_space["base_channels"]), max(self.search_space["base_channels"]))
                elif gene_name == "n_blocks":
                    new_value = random.randint(min(self.search_space["n_blocks"]), max(self.search_space["n_blocks"]))
                else:
                    # For other genes, use the usual method of selecting a random choice from possible_values
                    new_value = random.choice(choices)
            else:
                # For other genes, use the usual method of selecting a random choice from possible_values
                new_value = random.choice(choices)

            # If the new value is already the current value, try again to ensure we're not stuck in the same place
            if new_value == current_value:
                return self.mutate_gene(gene_name, current_value, possible_values)
            else:
                return {gene_name: new_value}

        else:
            # If no mutation was applied, simply return the current value
            return {gene_name: current_value}
