def combine_genes(self, gene_name, parent1_chromo, parent2_chromo, crossover_point, gene_index, total_genes):
    # Define the mutation probability for gene mutation and crossover point mutation
    gene_mutation_prob = 0.1
    crossover_point_mutation_prob = 0.05

    # Define a function to decide between parent1 and parent2 based on a biased coin flip
    def decide_between(parent1, parent2, gene_mutation_prob):
        if random.random() < gene_mutation_prob:
            return random.choice([parent1, parent2])
        else:
            return parent1 if random.random() < 0.5 else parent2

    # If the current gene index is less than the crossover point, decide between parent1 and parent2 based on a biased coin flip
    if gene_index < crossover_point:
        # With a higher probability, perform crossover point mutation
        if random.random() < crossover_point_mutation_prob:
            crossover_point = min(crossover_point + 1, total_genes) if crossover_point < total_genes - 1 else 1

        # Decide between parent1 and parent2 based on a biased coin flip
        parent1_or_mutated = decide_between(parent1_chromo[gene_name],
                                            decide_between(random.choice(self.search_space[gene_name]),
                                                           parent2_chromo[gene_name],
                                                           gene_mutation_prob),
                                            gene_mutation_prob)
    else:
        parent1_or_mutated = decide_between(parent2_chromo[gene_name],
                                            decide_between(random.choice(self.search_space[gene_name]),
                                                           parent1_chromo[gene_name],
                                                           gene_mutation_prob),
                                            gene_mutation_prob)

    # With a small probability, mutate the gene value to a random value within the search space
    if random.random() < gene_mutation_prob:
        parent1_or_mutated = random.choice(self.search_space[gene_name])

    return parent1_or_mutated
