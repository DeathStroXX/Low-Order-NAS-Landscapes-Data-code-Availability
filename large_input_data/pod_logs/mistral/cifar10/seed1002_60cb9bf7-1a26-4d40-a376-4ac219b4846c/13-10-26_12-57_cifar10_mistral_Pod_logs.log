def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))

        # Increase mutation probability for certain genes to encourage more drastic changes
        if gene_name in ["n_columns", "base_channels", "n_blocks", "dropout_prob", "fc_dropout", "lr", "momentum"]:
            mutation_probability = self.mutation_rate * 4  # Increase mutation probability for these genes
        else:
