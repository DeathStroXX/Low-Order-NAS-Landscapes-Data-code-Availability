def mutate_gene(self, gene_name, current_value, possible_values):
    if possible_values:
        choices = list(set(possible_values) - set([current_value]))
        if choices:
            mutation_probability = self.mutation_rate * 2  # Increase mutation probability
            if random.random() < mutation_probability:
                # Try generating a random neighbor architecture
                neighbor = self.random_neighbor(current_value)
                if neighbor in choices:
                    return neighbor
            else:
                # If no random neighbor was generated or it's not in the possible_values, return a random choice from the choices
                return random.choice(choices)

    return current_value

def random_neighbor(self, chromosome):
    # Define a sequence of small changes to apply to the current architecture
    changes = [
        (lambda x: x - 1 if x > 1 else x + 1, 0.1),  # Decrement or increment a gene value
        (lambda x: x + 1 if x not in self.search_space[gene_name] else x, 0.05),  # Try a value not currently in the search space
        (lambda x: self.search_space[gene_name][random.randint(0, len(self.search_space[gene_name]) - 1)] if gene_name in self.search_space else x, 0.05),  # Try a random value from the search space
    ]

    # Apply the changes to the current chromosome in a random order
    for _ in range(len(changes)):
        change, probability = changes[random.randint(0, len(changes) - 1)]
        if random.random() < probability:
            chromosome = change(chromosome)

    return chromosome
```

