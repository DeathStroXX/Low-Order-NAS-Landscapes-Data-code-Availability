    gene_mutation_prob = 0.1
    crossover_point_mutation_prob = 0.05

    # Define a function to decide between parent1 and parent2 based on a biased coin flip
    def decide_between(parent1, parent2, gene_mutation_prob):
        if random.random() < gene_mutation_prob:
            return random.choice([parent1, parent2])
        return parent1

    # If the current gene index is less than the crossover point, decide between parent1 and parent2
    if gene_index < crossover_point:
        # With a small probability, mutate the gene value to a random value within the search space
        if random.random() < gene_mutation_prob:
            gene_value = random.choice(self.search_space[gene_name])
        else:
