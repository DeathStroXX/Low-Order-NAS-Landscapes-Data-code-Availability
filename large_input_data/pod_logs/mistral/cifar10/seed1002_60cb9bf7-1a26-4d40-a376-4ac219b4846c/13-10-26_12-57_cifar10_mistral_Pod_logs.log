            # Decide between parent1_decision and parent2_decision based on a biased coin flip
            gene_value = decide_between(parent1_value, parent2_value, 0.5) if random.random() < 0.5 else crossover_point_decision

    # If the current gene index is greater than or equal to the crossover point, decide between parent2 and parent1
    else:
