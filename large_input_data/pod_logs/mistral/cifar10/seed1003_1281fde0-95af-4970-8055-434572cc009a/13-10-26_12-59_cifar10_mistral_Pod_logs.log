        selected_index = random.uniform(0, 1)
        selected_competitor = next((wheel for _, wheel in roulette_wheel if selected_index <= wheel[0]), None)

        # If no competitor was selected due to a tie, use a random competitor from the tournament
        if selected_competitor is None:
            selected_competitor = random.choice(tournament)

    return selected_competitor
