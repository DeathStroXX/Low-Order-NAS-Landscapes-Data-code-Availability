### mutate_gene ###
def mutate_gene(self, gene_name, current_value, possible_values):
    if len(possible_values) > 1:
        if self.mutation_rate > 0.5:
            # High mutation rate, try to move towards extremes
            if random.random() < self.mutation_rate:
                return max(possible_values) if current_value < max(possible_values) else min(possible_values)
            else:
                # Randomly pick a value different from the current one
                choices = list(set(possible_values) - set([current_value]))
                return random.choice(choices)
        else:
            # Medium mutation rate, try to explore nearby values
            if random.random() < self.mutation_rate:
                choices = list(set(possible_values) - set([current_value]))
                return random.choice(choices)
    elif len(possible_values) == 1 and current_value != possible_values[0]:
        # If there is only one possible value and it's not the current one, swap to the new value
        return possible_values[0]
    else:
        # If there are no possible values or the current value is the only one possible, return the current value
        return current_value
