```python
def _create_random_chromosome(self):
    chromosome = {}
    total_values = sum([len(values) for _, values in self.search_space.items()])
    weights = [total_values * (1 / len(values)) for _, values in self.search_space.items()]

    for key in self.search_space:
        if key in ['n_columns', 'base_channels', 'n_blocks']:
            chromosome[key] = random.choices(self.search_space[key], weights=weights, k=2)[0]
        elif key in ['dropout_prob', 'fc_dropout', 'lr', 'momentum']:
            chromosome[key] = random.uniform(*tuple(self.search_space[key]))
        elif key in ['activation', 'conv_type', 'pooling_type', 'norm_type', 'optimizer_type']:
            chromosome[key] = random.choices(self.search_space[key], weights=weights, weights=[w / total_values for w in weights], k=2)[0]
        elif key in ['kernel_size']:
            chromosome[key] = random.choices(self.search_space[key], k=2)[0]

    # Ensure at least one unique combination for n_columns, base_channels, and n_blocks
    if len(set([chromosome['n_columns'], chromosome['base_channels'], chromosome['n_blocks']]) ) < 3:
        chromosome['n_columns'] = random.choice(list(set(self.search_space['n_columns']) - set([chromosome['n_columns']])))
        chromosome['base_channels'] = random.choice(list(set(self.search_space['base_channels']) - set([chromosome['base_channels']])))
        chromosome['n_blocks'] = random.choice(list(set(self.search_space['n_blocks']) - set([chromosome['n_blocks']])))

    return chromosome
```

This new implementation creates chromosomes with at least one unique combination for `n_columns`, `base_channels`, and `n_blocks`. This encourages the GA to explore different architectures and break out of local minima.
