import random

def _create_random_chromosome(self):
    chromosome = {}
    sample_size = len(self.search_space)
    samples = [None] * sample_size
    for key, values in self.search_space.items():
        samples[key] = random.choices(values, weights=[1 / len(values) for _ in values])[0]

    # Create the chromosome using stochastic universal sampling (SUS)
    for key in self.search_space:
        chromosome[key] = samples[key]
        for i in range(len(samples)):
            if i != key:
                if random.random() < (len(samples[i]) / len(samples[key])):
                    chromosome[key] = samples[i]
                    break

    return chromosome
```

