### combine_genes ###
def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    # Ensure that crossover_point is within the total genes
    crossover_point = min(crossover_point, total_genes)

    # Use a random value from the search space if crossover_point equals total genes
    if crossover_point == total_genes:
        return random.choice(self.search_space[gene_name])

    # Combine genes if gene_index is less than crossover_point
    if gene_index < crossover_point:
        return parent1_value
    else:
        return parent2_value

    # Implement strategies to maintain genetic diversity and avoid premature convergence
    # 1. Gene Mutation: Change a certain percentage of genes in the child chromosome randomly
    mutation_rate = 0.1
    if random.random() < mutation_rate:
        mutated_value = random.choice(self.search_space[gene_name])
        return mutated_value

    # 2. Parent Swap: Swap genes between the parents if a certain condition is met
    swap_probability = 0.2
    if random.random() < swap_probability:
        if parent1_value != parent2_value:
            return parent1_value if random.random() < 0.5 else parent2_value

    # 3. Gene Recombination: Create a new value by combining elements from both parents
    recombination_probability = 0.15
    if random.random() < recombination_probability:
        possible_values = list(set(self.search_space[gene_name]) - set([parent1_value, parent2_value]))
        if possible_values:
            return random.choice(possible_values)

    # If no strategies are applied, return one of the parent values randomly
    return random.choice([parent1_value, parent2_value])
