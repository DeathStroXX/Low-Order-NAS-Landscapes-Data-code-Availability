def mutate_gene(self, gene_name, current_value, possible_values):
    mutation_probability = self.mutation_rate * 4  # Increase mutation probability significantly
    if random.random() < mutation_probability:
        if gene_name == 'activation':
            new_activation = random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
            while new_activation == current_value:
                new_activation = random.choice(['ReLU', 'GELU', 'LeakyReLU', 'SiLU'])
            return new_activation
        elif gene_name == 'kernel_size':
            return random.choice([1, 3, 5, 7])
        elif gene_name == 'base_channels':
            return random.choice([16, 32, 64])
        elif gene_name == 'n_blocks':
            return random.choice([2, 3, 4])
        elif gene_name == 'dropout_prob':
            return random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
        elif gene_name == 'fc_dropout':
            return random.choice([0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.4, 0.5])
        elif gene_name == 'lr':
            return random.choice([0.01, 0.008, 0.006, 0.005, 0.004, 0.003, 0.002, 0.001])
        elif gene_name == 'momentum':
            return random.choice([0.75, 0.8, 0.85, 0.88, 0.9, 0.92, 0.95, 0.98])
        elif gene_name == 'pooling_type':
            return random.choice(['Max', 'Avg'])
        elif gene_name == 'conv_type':
            return random.choice(['Standard', 'Depthwise'])
        elif gene_name == 'norm_type':
            return random.choice(['BatchNorm', 'InstanceNorm'])
        elif gene_name == 'optimizer_type':
            return random.choice(['SGD', 'AdamW', 'RMSprop'])
    return current_value
