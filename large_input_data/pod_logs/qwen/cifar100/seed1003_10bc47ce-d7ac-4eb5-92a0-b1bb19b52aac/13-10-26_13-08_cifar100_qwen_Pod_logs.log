    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        # Implement complex crossover logic to maintain genetic diversity
        if gene_index < crossover_point:
            return parent1_value
        else:
            return parent2_value
        
        # Additional strategies to explore the search space and avoid premature convergence
        if gene_name == 'activation':
            # Introduce a mix of activation functions
            if random.random() < 0.5:
                return parent1_value
            else:
                return parent2_value
        elif gene_name == 'kernel_size':
            # Use arithmetic mean of kernel sizes
            return (parent1_value + parent2_value) // 2
        elif gene_name == 'base_channels':
            # Use geometric mean of base channels
            return int((parent1_value * parent2_value) ** 0.5)
        elif gene_name == 'n_blocks':
            # Use harmonic mean of number of blocks
            if parent1_value + parent2_value == 0:
                return 0
            return int(total_genes / ((1 / parent1_value) + (1 / parent2_value)))
        elif gene_name == 'dropout_prob' or gene_name == 'fc_dropout':
            # Use midpoint between dropout probabilities
            return (parent1_value + parent2_value) / 2
        elif gene_name == 'lr':
            # Use logarithmic interpolation between learning rates
            return math.exp((math.log(parent1_value) + math.log(parent2_value)) / 2)
        elif gene_name == 'momentum':
            # Use weighted average of momentum
            weight = random.random()
            return weight * parent1_value + (1 - weight) * parent2_value
        elif gene_name == 'pooling_type':
            # Cycle through pooling types
            pool_types = ['Max', 'Avg']
            current_type = parent1_value if random.random() < 0.5 else parent2_value
            next_type_index = (pool_types.index(current_type) + 1) % len(pool_types)
            return pool_types[next_type_index]
        elif gene_name == 'conv_type':
            # Toggle convolution type
            return 'Standard' if parent1_value == 'Depthwise' else 'Depthwise'
        elif gene_name == 'norm_type':
            # Cycle through normalization types
            norm_types = ['BatchNorm', 'InstanceNorm']
            current_type = parent1_value if random.random() < 0.5 else parent2_value
            next_type_index = (norm_types.index(current_type) + 1) % len(norm_types)
            return norm_types[next_type_index]
        elif gene_name == 'optimizer_type':
            # Toggle optimizer type
            return 'AdamW' if parent1_value == 'RMSprop' else 'RMSprop'
        else:
            return parent1_value
