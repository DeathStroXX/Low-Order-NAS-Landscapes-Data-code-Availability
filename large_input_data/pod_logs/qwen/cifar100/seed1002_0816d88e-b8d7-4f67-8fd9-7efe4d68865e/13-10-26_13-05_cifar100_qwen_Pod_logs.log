def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name in ["n_columns", "base_channels", "n_blocks"]:
        # Discrete parameters: Choose randomly between parents
        return random.choice([parent1_value, parent2_value])
    
    if gene_name in ["dropout_prob", "fc_dropout", "lr", "momentum"]:
        # Continuous parameters: Blend linearly but with some randomness
        alpha = random.uniform(0.5, 1.5)
        blended_value = parent1_value + alpha * (parent2_value - parent1_value)
        return blended_value
    
    if gene_name == "accuracy":
        # For accuracy, we take the best value from either parent to prevent premature convergence
        return max(parent1_value, parent2_value)
    
    if gene_name in ["activation", "kernel_size", "pooling_type", "conv_type", "norm_type", "optimizer_type"]:
        # Categorical parameters: Use one-hot encoding and blend
        parent1_encoded = self._one_hot_encode(gene_name, parent1_value)
        parent2_encoded = self._one_hot_encode(gene_name, parent2_value)
        blended_encoded = [p1 + p2 for p1, p2 in zip(parent1_encoded, parent2_encoded)]
        return self._decode_categorical(gene_name, blended_encoded)
    
    raise ValueError(f"Unknown gene: {gene_name}")

def _one_hot_encode(self, gene_name, value):
    possible_values = self.search_space[gene_name]
    encoded = [int(val == value) for val in possible_values]
    return encoded

def _decode_categorical(self, gene_name, encoded):
    possible_values = self.search_space[gene_name]
    index = encoded.index(max(encoded))
    return possible_values[index]
