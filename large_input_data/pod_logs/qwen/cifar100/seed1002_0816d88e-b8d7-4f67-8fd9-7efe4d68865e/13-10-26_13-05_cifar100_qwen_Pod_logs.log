def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name in ["n_columns", "base_channels", "n_blocks"]:
        # Discrete parameters: Choose randomly between parents
        return random.choice([parent1_value, parent2_value])
    
    if gene_name in ["dropout_prob", "fc_dropout"]:
        # Continuous parameters: Blend linearly but with some randomness
        alpha = random.uniform(0.3, 1.2)
        blended_value = parent1_value + alpha * (parent2_value - parent1_value)
        return max(min(blended_value, 0.5), 0.05)  # Clamp to valid range
    
    if gene_name == "lr":
        # Learning rate: Exponential blend with some randomness
        alpha = random.uniform(0.2, 2.0)
        blended_value = parent1_value ** alpha * parent2_value ** (1 / alpha)
        return blended_value
    
    if gene_name == "momentum":
        # Momentum: Exponential blend with some randomness
        alpha = random.uniform(0.2, 2.0)
        blended_value = parent1_value ** alpha * parent2_value ** (1 / alpha)
        return blended_value
    
    if gene_name in ["activation", "kernel_size", "pooling_type", "conv_type", "norm_type", "optimizer_type"]:
        # Categorical parameters: Randomly choose from both parents with equal probability
        combined_choices = set(parent1_value.split('_') + parent2_value.split('_'))
        chosen_option = '_'.join(random.sample(combined_choices, 1))[1:]
        return chosen_option
