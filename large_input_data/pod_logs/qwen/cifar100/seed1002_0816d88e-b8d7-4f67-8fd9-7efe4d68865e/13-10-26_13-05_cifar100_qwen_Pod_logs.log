def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name in ["n_columns", "base_channels", "n_blocks"]:
        # Discrete parameters: Choose randomly between parents
        choices = [parent1_value, parent2_value]
        # Introduce genetic diversity by choosing from all possible values
        choices.extend(list(self.search_space[gene_name])[:len(choices)])
        return random.choice(choices)
    
    if gene_name in ["dropout_prob", "fc_dropout"]:
        # Continuous parameters: Blend linearly but with some randomness
        alpha = random.uniform(0.3, 1.2)
        blended_value = parent1_value + alpha * (parent2_value - parent1_value)
        return max(min(blended_value, 0.5), 0.05)  # Clamp to valid range
    
    if gene_name == "lr":
        # Learning rate: Exponential blend with some randomness
        alpha = random.uniform(0.3, 1.2)
        blended_value = parent1_value * (parent2_value / parent1_value) ** alpha
        return max(min(blended_value, 0.01), 0.0001)  # Clamp to valid range
    
    if gene_name in ["momentum"]:
        # Momentum: Blend linearly but with some randomness
        alpha = random.uniform(0.3, 1.2)
        blended_value = parent1_value + alpha * (parent2_value - parent1_value)
        return max(min(blended_value, 0.98), 0.75)  # Clamp to valid range
    
    if gene_name in ["activation"]:
        # Activation: Randomly choose between parents
        return random.choice([parent1_value, parent2_value])
    
    if gene_name in ["kernel_size"]:
        # Kernel size: Average the sizes and round to nearest integer
        avg_size = int((parent1_value + parent2_value) / 2)
        choices = [avg_size - 1, avg_size, avg_size + 1]
        # Introduce genetic diversity by choosing from all possible values
        choices.extend(list(self.search_space[gene_name])[:len(choices)])
        return random.choice(choices)
    
    if gene_name in ["pooling_type"]:
        # Pooling type: Randomly choose between parents
        return random.choice([parent1_value, parent2_value])
    
    if gene_name in ["conv_type"]:
        # Convolution type: Randomly choose between parents
        return random.choice([parent1_value, parent2_value])
    
    if gene_name in ["norm_type"]:
        # Normalization type: Randomly choose between parents
        return random.choice([parent1_value, parent2_value])
    
    if gene_name in ["optimizer_type"]:
        # Optimizer type: Randomly choose between parents
        return random.choice([parent1_value, parent2_value])
