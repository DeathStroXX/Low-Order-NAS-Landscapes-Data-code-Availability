def _create_random_chromosome(self):
    chromosome = {}
    for key, values in self.search_space.items():
        if key == "n_columns":
            chromosome[key] = random.choice([2, 4])  # Force exploration of different numbers of columns
        elif key == "base_channels":
            chromosome[key] = random.choice([16, 64])  # Explore larger or smaller base channels
        elif key == "n_blocks":
            chromosome[key] = random.choice([2, 4])  # Force exploration of different numbers of blocks
        elif key == "dropout_prob":
            chromosome[key] = random.choice([0.15, 0.25])  # Increase dropout probability for regularization
        elif key == "fc_dropout":
            chromosome[key] = random.choice([0.1, 0.3])  # Adjust fully connected dropout
        elif key == "lr":
            chromosome[key] = random.choice([0.003, 0.008])  # Explore learning rates
        elif key == "momentum":
            chromosome[key] = random.choice([0.8, 0.95])  # Increase momentum for faster convergence
        elif key == "activation":
            chromosome[key] = random.choice(["SiLU", "LeakyReLU"])  # Try alternative activations
        elif key == "kernel_size":
            chromosome[key] = random.choice([3, 5])  # Explore kernel sizes
        elif key == "pooling_type":
            chromosome[key] = random.choice(["Max", "Avg"])  # Force exploration of different pooling types
        elif key == "conv_type":
            chromosome[key] = random.choice(["Standard", "Depthwise"])  # Explore convolution types
        elif key == "norm_type":
            chromosome[key] = random.choice(["BatchNorm", "InstanceNorm"])  # Explore normalization types
        elif key == "optimizer_type":
            chromosome[key] = random.choice(["AdamW", "RMSprop"])  # Explore optimizer types
    return chromosome
