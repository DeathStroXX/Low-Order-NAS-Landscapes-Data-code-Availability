def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name in ["n_columns", "base_channels", "n_blocks"]:
        # Discrete parameters: Choose a unique combination of both parents
        combined_value = (parent1_value + parent2_value) % len(self.search_space[gene_name])
        return combined_value

    elif gene_name in ["dropout_prob", "fc_dropout", "lr", "momentum"]:
        # Continuous parameters: Blend linearly and apply noise to avoid premature convergence
        alpha = random.uniform(0.3, 0.7)
        blended_value = parent1_value + alpha * (parent2_value - parent1_value)
        noise = random.uniform(-0.1, 0.1)
        combined_value = blended_value + noise
        return self._coerce_gene_value(gene_name, combined_value)

    elif gene_name == "activation":
        # Categorical parameter: Randomly choose between parent options
        return random.choice([parent1_value, parent2_value])

    elif gene_name == "kernel_size":
        # Discrete parameter with a twist: Use a geometric progression
        p1 = parent1_value
        p2 = parent2_value
        if p1 == p2:
            return p1
        else:
            ratio = (p2 / p1) ** (1 / total_genes)
            return int(round(p1 * ratio))

    elif gene_name == "pooling_type" or gene_name == "conv_type" or gene_name == "norm_type" or gene_name == "optimizer_type":
        # Categorical parameter: Cycle through all possibilities
        current_idx = self.search_space[gene_name].index(chrom[gene_name])
        next_idx = (current_idx + 1) % len(self.search_space[gene_name])
        return self.search_space[gene_name][next_idx]

    else:
        raise ValueError(f"Unhandled gene name: {gene_name}")
