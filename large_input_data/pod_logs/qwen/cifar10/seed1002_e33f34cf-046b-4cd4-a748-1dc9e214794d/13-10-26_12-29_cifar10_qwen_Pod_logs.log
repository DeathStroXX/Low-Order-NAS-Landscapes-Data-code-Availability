    def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
        if gene_name == 'accuracy':
            # For accuracy, we take the best value from either parent to prevent premature convergence
            return max(parent1_value, parent2_value)
        
        if gene_name in ['n_columns', 'base_channels', 'n_blocks']:
            # For discrete parameters, choose randomly between parents to add diversity
            return random.choice([parent1_value, parent2_value])
        
        if gene_name in ['dropout_prob', 'fc_dropout', 'lr', 'momentum']:
            # For continuous parameters, blend linearly but with some randomness
            alpha = random.uniform(0.3, 0.7)
            blended_value = parent1_value + alpha * (parent2_value - parent1_value)
            return blended_value
        
        if gene_name == 'activation':
            # For categorical parameters, alternate between parents
            alt_order = [parent1_value, parent2_value]
            if gene_index % 2 == 0:
                return alt_order[0]
            else:
                return alt_order[1]
        
        if gene_name in ['kernel_size', 'pooling_type', 'conv_type', 'norm_type', 'optimizer_type']:
            # For categorical parameters, choose randomly between parents to add diversity
            return random.choice([parent1_value, parent2_value])
