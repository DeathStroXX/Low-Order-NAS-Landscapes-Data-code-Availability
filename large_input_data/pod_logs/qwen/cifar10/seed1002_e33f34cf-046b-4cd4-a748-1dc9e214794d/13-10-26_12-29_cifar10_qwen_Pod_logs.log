def combine_genes(self, gene_name, parent1_value, parent2_value, crossover_point, gene_index, total_genes):
    if gene_name in ["n_columns", "base_channels", "n_blocks"]:
        # Discrete parameters: Choose a unique combination of both parents
        combined_value = (parent1_value + parent2_value) % len(self.search_space[gene_name])
        return self._coerce_gene_value(gene_name, combined_value)

    elif gene_name in ["dropout_prob", "fc_dropout", "lr", "momentum"]:
        # Continuous parameters: Blend linearly and apply noise to avoid premature convergence
        alpha = random.uniform(0.3, 0.7)
        blended_value = parent1_value + alpha * (parent2_value - parent1_value)
        noise = random.uniform(-0.1, 0.1)
        combined_value = blended_value + noise
        return self._coerce_gene_value(gene_name, combined_value)

    elif gene_name == "activation":
        # Cyclic parameter: Cycle through activation functions
        activations = ["ReLU", "GELU", "LeakyReLU", "SiLU"]
        current_idx = activations.index(parent1_value)
        next_idx = (current_idx + 1) % len(activations)
        return activations[next_idx]

    elif gene_name in ["kernel_size", "pooling_type", "conv_type", "norm_type", "optimizer_type"]:
        # Discrete parameters: Select from a subset of possible values
        possible_values = self.search_space[gene_name]
        combined_value = random.choice(possible_values)
        return self._coerce_gene_value(gene_name, combined_value)

    else:
        raise ValueError(f"Unsupported gene name: {gene_name}")
